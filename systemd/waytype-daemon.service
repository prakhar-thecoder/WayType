[Unit]
Description=WayType GUI Daemon
After=graphical-session.target

[Service]
# NOTE: Replace /home/prakhar/Projects/WayType with the absolute path to your cloned repository.
ExecStart=/usr/bin/python3 -m ui.daemon
WorkingDirectory=/home/prakhar/Projects/WayType
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
