# Required: Groq API key for Voxora Whisper transcription and optional formatting
GROQ_API_KEY=your_groq_api_key_here

# Optional Voxora speech settings
WHISPER_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
VAD_MODE=2
SAMPLE_RATE=16000
FRAME_DURATION_MS=20
PRE_SPEECH_DURATION=0.3
MAX_RECORDING_DURATION=300
SPEECH_START_TIMEOUT=10

# Optional formatter settings; FORMAT_API_KEY falls back to GROQ_API_KEY
FORMAT_BASE_URL=https://api.groq.com/openai/v1
FORMAT_MODEL=openai/gpt-oss-120b
FORMAT_API_KEY=
